# Nexus configuration settings
# Copy to .env and fill in keys as needed (no hardcoded keys).

# Model Configuration (CPU-friendly defaults for <=4 GB RAM VMs)
MODEL_NAME=Qwen/Qwen3-8B                  # Remote HF Inference API model (do NOT load locally on 4 GB CPU)
EMBEDDING_MODEL=thenlper/gte-small        # 384-dim CPU-friendly embedder (~130 MB)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_PROVIDER=groq                         # groq, openrouter, offline
LLM_MODEL=qwen/qwen3.8-27b
TEMPERATURE=0.0
OFFLINE_EVAL=false                        # Set true for deterministic offline extractive synthesis

# API Keys (leave empty to use offline deterministic synthesis)
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# Observability (LangSmith tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Nexus

# Qdrant Vector Database
QDRANT_URL=                               # Empty = in-memory (or QDRANT_PATH); in Docker Compose set http://qdrant:6333
QDRANT_PATH=                              # Optional local disk path for single-container deploys (e.g. metadata/qdrant_local)
QDRANT_COLLECTION=nexus_chunks
QDRANT_DISTANCE=Dot
QDRANT_API_KEY=

# Keyword / BM25 Index
BM25_INDEX_PATH=metadata/chunks.json

# Chunking & Retrieval Parameters
CHUNK_SIZE=200
CHUNK_OVERLAP=30
TOP_K=10
DENSE_TOP_K=10
KEYWORD_TOP_K=10
FUSION_TOP_K=20
RERANK_TOP_K=5
FINAL_TOP_K=5
FUSION_METHOD=rrf
RERANKER_ENABLED=true
CONDITIONAL_RERANKING_ENABLED=true
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.60
MAX_PARENT_EXPANSIONS=3
MAX_PARENT_TOKENS=1200
MAX_CONTEXT_TOKENS=2048
METADATA_FILTER_ENABLED=true
PAYLOAD_INDEXES_ENABLED=true

# Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# Ingestion & System Binaries
OCR_ENABLED=true
TESSERACT_CMD=/usr/bin/tesseract          # C:\Program Files\Tesseract-OCR\tesseract.exe on Windows
TRANSCRIBE_AUDIO_VIDEO=false              # Keep false on <=4 GB CPU VMs (avoids loading Whisper)
WHISPER_MODEL=base

# API Server & Logging
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
