# Nexus configuration settings
# Copy to .env and fill in keys as needed (no hardcoded keys).

# Model & Inference Configuration
MODEL_NAME=Qwen/Qwen3-8B                  # Remote HF Inference API model (do NOT load locally on 4 GB CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5    # Options: BAAI/bge-small-en-v1.5 (384d), thenlper/gte-small (384d), google/embeddinggemma-2 (768d)
EMBEDDING_DIMENSION=384                   # Optional target vector dimension for MRL models
EMBEDDING_DEVICE=cpu                      # cpu or cuda
ALLOW_MOCK_EMBEDDER=0                     # Set to 1 only in offline unit tests

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu                       # cpu or cuda

LLM_PROVIDER=groq                         # auto, groq, gemini, openrouter, offline
LLM_MODEL=llama-3.3-70b-versatile         # Groq: llama-3.3-70b-versatile, Gemini: gemini-1.5-flash, OpenRouter: meta-llama/llama-3.2-3b-instruct:free
LLM_FALLBACK_PROVIDER=offline             # Automatic failover provider: offline, gemini, openrouter
LLM_FALLBACK_MODEL=
LLM_TIMEOUT=10.0                          # Network request timeout in seconds
LLM_MAX_RETRIES=2                         # Exponential backoff retry limit
TEMPERATURE=0.0
OFFLINE_EVAL=false                        # Set true for deterministic offline extractive synthesis

# Free-Tier Provider API Keys (leave empty for offline local extractive RAG)
GROQ_API_KEY=                             # Free-tier Groq API key: https://console.groq.com/keys
GEMINI_API_KEY=                           # Free-tier Google Gemini key: https://aistudio.google.com
OPENROUTER_API_KEY=                       # Free-tier OpenRouter key: https://openrouter.ai
HF_TOKEN=

# Observability (LangSmith tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Nexus

# Qdrant Vector Database & HNSW Indexing
QDRANT_URL=                               # Empty = in-memory (or QDRANT_PATH); in Docker Compose set http://qdrant:6333
QDRANT_PATH=                              # Optional local disk path for single-container deploys (e.g. metadata/qdrant_local)
QDRANT_COLLECTION=nexus_chunks
QDRANT_API_KEY=
QDRANT_DISTANCE=Dot                       # Dot, Cosine, Euclid

# HNSW (Hierarchical Navigable Small World) Indexing Parameters
HNSW_M=16                              # Number of edges per node in HNSW graph (16-64)
HNSW_EF_CONSTRUCT=100                  # Neighbors considered during index construction (64-256)
HNSW_FULL_SCAN_THRESHOLD=10000        # Minimum vectors threshold before HNSW graph indexing
HNSW_ON_DISK=false                     # Store HNSW index graph on disk
HNSW_EF_SEARCH=64                      # Query-time search depth (higher = higher recall)

# Keyword / BM25 Index
BM25_INDEX_PATH=metadata/chunks.json

# Chunking & Retrieval Parameters
CHUNK_SIZE=200
CHUNK_OVERLAP=30
TOP_K=10
DENSE_TOP_K=10
KEYWORD_TOP_K=10
FUSION_TOP_K=20
RERANK_TOP_K=5
FINAL_TOP_K=5
FUSION_METHOD=rrf
RERANKER_ENABLED=true
CONDITIONAL_RERANKING_ENABLED=true
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.60
MAX_PARENT_EXPANSIONS=3
MAX_PARENT_TOKENS=1200
MAX_CONTEXT_TOKENS=2048
METADATA_FILTER_ENABLED=true
PAYLOAD_INDEXES_ENABLED=true

# Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# Ingestion & System Binaries
OCR_ENABLED=true
TESSERACT_CMD=/usr/bin/tesseract          # C:\Program Files\Tesseract-OCR\tesseract.exe on Windows
TRANSCRIBE_AUDIO_VIDEO=false              # Keep false on <=4 GB CPU VMs (avoids loading Whisper)
WHISPER_MODEL=base

# API Server & Logging
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
