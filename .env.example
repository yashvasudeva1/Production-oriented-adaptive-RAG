# ResearchLens configuration settings
# Open source models via Groq, Hugging Face, or OpenRouter

# Model Configuration
MODEL_NAME=Qwen/Qwen3-8B
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_PROVIDER=groq                      # groq, openrouter, huggingface, offline
LLM_MODEL=qwen/qwen3.8-27b              # or groq/compound-mini, meta-llama/llama-3.1-8b-instruct:free
TEMPERATURE=0.0

# API Keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# Observability (LangSmith tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ResearchLens

# Qdrant Vector Database
QDRANT_URL=                            # Leave empty for in-memory embedded Qdrant, or set e.g. http://localhost:6333
QDRANT_COLLECTION=researchlens_chunks
QDRANT_API_KEY=

# Keyword / BM25 Index
BM25_INDEX_PATH=metadata/chunks.json

# Chunking & Retrieval Parameters
CHUNK_SIZE=400
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=30
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=250
TOP_K=10
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=2048

# Ingestion & System Binaries
OCR_ENABLED=true
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe  # Or /usr/bin/tesseract on Linux
TRANSCRIBE_AUDIO_VIDEO=false
WHISPER_MODEL=base

# API Server
API_HOST=127.0.0.1
API_PORT=8000
