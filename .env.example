# ResearchLens configuration settings
# Open source models via Groq, Hugging Face, or OpenRouter

# Model & Inference Configuration (100% Free / Open-Weight / Local / Free-Tier)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5      # Options: BAAI/bge-small-en-v1.5 (384d, fast local), google/embeddinggemma-2 (768d, local Gemma), gemini-embedding-2 (768d/3072d, cloud free tier)
EMBEDDING_DIMENSION=768                    # Optional: Target vector dimension for MRL models (e.g. 768 for gemini-embedding-2 or embeddinggemma-2)
EMBEDDING_DEVICE=cpu                       # cpu or cuda
ALLOW_MOCK_EMBEDDER=0                      # Set to 1 only in offline unit tests

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu                        # cpu or cuda
RERANKER_ENABLED=true                      # Conditional reranking enabled

LLM_PROVIDER=auto                          # auto (detects key), groq, gemini, openrouter, offline
LLM_MODEL=llama-3.3-70b-versatile          # Groq: llama-3.3-70b-versatile, Gemini: gemini-1.5-flash, OpenRouter: meta-llama/llama-3.2-3b-instruct:free
LLM_FALLBACK_PROVIDER=offline              # Automatic failover provider: offline, gemini, openrouter
LLM_FALLBACK_MODEL=
LLM_TIMEOUT=10.0                           # Network request timeout in seconds
LLM_MAX_RETRIES=2                          # Exponential backoff retry limit
TEMPERATURE=0.0

# Free-Tier Provider API Keys (Leave blank for 100% offline local extractive RAG)
GROQ_API_KEY=                              # Free-tier Groq API key: https://console.groq.com/keys
GEMINI_API_KEY=                            # Free-tier Google Gemini key: https://aistudio.google.com
OPENROUTER_API_KEY=                        # Free-tier OpenRouter key: https://openrouter.ai
HF_TOKEN=

# Observability (LangSmith tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ResearchLens

# Qdrant Vector Database & HNSW Indexing
QDRANT_URL=                            # Leave empty for in-memory embedded Qdrant, or set e.g. http://localhost:6333
QDRANT_COLLECTION=researchlens_chunks
QDRANT_API_KEY=
QDRANT_DISTANCE=Dot                    # Dot, Cosine, Euclid

# HNSW (Hierarchical Navigable Small World) Indexing Parameters
HNSW_M=16                              # Number of edges per node in HNSW graph (16-64)
HNSW_EF_CONSTRUCT=100                  # Neighbors considered during index construction (64-256)
HNSW_FULL_SCAN_THRESHOLD=10000        # Minimum vectors threshold before HNSW graph indexing
HNSW_ON_DISK=false                     # Store HNSW index graph on disk
HNSW_EF_SEARCH=64                      # Query-time search depth (higher = higher recall)

# Keyword / BM25 Index
BM25_INDEX_PATH=metadata/chunks.json

# Chunking & Retrieval Parameters
CHUNK_SIZE=400
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=30
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=250
TOP_K=10
RERANK_TOP_K=5
MAX_CONTEXT_TOKENS=2048

# Ingestion & System Binaries
OCR_ENABLED=true
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe  # Or /usr/bin/tesseract on Linux
TRANSCRIBE_AUDIO_VIDEO=false
WHISPER_MODEL=base

# API Server
API_HOST=127.0.0.1
API_PORT=8000
